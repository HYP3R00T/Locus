{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,mjs,cjs,ts,tsx,jsx,mts,cts,css,json,jsonc,svg}",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/out",
      "!!**/target",
      "!!**/gen",
      "!!**/public/pdfjs",
      "!**/next-env.d.ts",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  }
}
